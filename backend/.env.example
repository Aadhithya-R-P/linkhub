DB_HOST=localhost
DB_PORT=5432
DB_NAME=linkhub
DB_USER=linkhub_app
# Copy this file to .env and replace the placeholder privately.
DB_PASSWORD='replace_with_your_linkhub_app_password'
# Generate JWT_SECRET with secrets.token_urlsafe(32); do not commit the real key.
JWT_SECRET=''
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# false is for local HTTP only; production HTTPS must use true.
REFRESH_COOKIE_SECURE=false
# Exact browser origins; this does not enable CORS.
AUTH_ALLOWED_ORIGINS='["http://127.0.0.1:8000","http://localhost:8000"]'
